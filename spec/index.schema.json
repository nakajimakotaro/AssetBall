{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetBall Index version 1",
  "type": "object",
  "required": ["format", "version", "hashAlgorithm", "ball", "assets"],
  "properties": {
    "format": { "const": "assetball" },
    "version": { "const": 1 },
    "hashAlgorithm": { "const": "sha256" },
    "ball": {
      "type": "object",
      "required": ["file", "size", "hash"],
      "properties": {
        "file": { "type": "string", "pattern": "^ball-[0-9a-f]{64}\\.bin$" },
        "size": { "$ref": "#/$defs/size" },
        "hash": { "$ref": "#/$defs/hash" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "offset", "size", "hash"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "offset": { "$ref": "#/$defs/size" },
          "size": { "$ref": "#/$defs/size" },
          "hash": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": {
    "size": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
